
/* ===== INSTA X YOU - LIQUID GLASS ===== */

:root {
  --bg: #090613;
  --panel: rgba(255,255,255,.075);
  --line: rgba(255,255,255,.19);
  --purple: #c4a5ff;
  --pink: #f0a5ff;
  --text: #ffffff;
  --muted: #b9accd;
}

body {
  background:
    radial-gradient(ellipse at 5% 5%, #7135b9 0%, transparent 38%),
    radial-gradient(ellipse at 100% 35%, #4b207e 0%, transparent 35%),
    radial-gradient(ellipse at 50% 100%, #32145d 0%, transparent 45%),
    #090613;
  background-attachment: fixed;
}

/* Glass surfaces */
.glass {
  position: relative;
  overflow: hidden;
  background: linear-gradient(
    145deg,
    rgba(255,255,255,.14),
    rgba(255,255,255,.035) 50%,
    rgba(190,140,255,.07)
  );
  border: 1px solid rgba(255,255,255,.22);
  border-top-color: rgba(255,255,255,.38);
  border-radius: 25px;
  backdrop-filter: blur(28px) saturate(180%);
  -webkit-backdrop-filter: blur(28px) saturate(180%);
  box-shadow:
    0 15px 45px rgba(0,0,0,.28),
    inset 0 1px 1px rgba(255,255,255,.16);
}

/* Light reflections */
.glass::before {
  content: "";
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 45%;
  background: linear-gradient(
    180deg,
    rgba(255,255,255,.09),
    transparent
  );
  pointer-events: none;
  border-radius: inherit;
}

.glass > * {
  position: relative;
  z-index: 1;
}

/* Header */
header {
  padding-top: 17px;
}

.logo {
  background: linear-gradient(
    100deg,#ffffff,#c4a5ff,#f0a5ff
  );
  color: transparent;
  background-clip: text;
  -webkit-background-clip: text;
  filter: drop-shadow(0 0 12px #a855f755);
}

/* Welcome */
.welcome {
  border-radius: 28px;
  padding: 23px;
  box-shadow: 0 15px 45px #0004,
              inset 0 1px 2px #ffffff33;
}

.welcome h1 {
  letter-spacing: -.8px;
}

/* Search */
.search,
.composer input,
.comment-form input,
.field {
  background: rgba(255,255,255,.075);
  border: 1px solid rgba(255,255,255,.2);
  border-radius: 17px;
  backdrop-filter: blur(18px);
  -webkit-backdrop-filter: blur(18px);
  box-shadow: inset 0 1px 2px #ffffff12;
}

.search {
  padding: 16px;
}

input::placeholder,
textarea::placeholder {
  color: #b9accd;
}

/* Stories */
.story-ring {
  background: linear-gradient(
    135deg,#ffffff,#a855f7,#ec4899,#8b5cf6
  );
  box-shadow: 0 0 18px #a855f755;
}

.story-ring span {
  background: #21132f;
}

/* Buttons */
.primary {
  background: linear-gradient(
    120deg,#8b5cf6,#b44bdb,#e879f9
  );
  border: 1px solid rgba(255,255,255,.28);
  box-shadow:
    0 5px 20px #9333ea55,
    inset 0 1px 2px #ffffff55;
  transition: transform .2s, filter .2s;
}

.primary:active {
  transform: scale(.95);
  filter: brightness(1.2);
}

/* Posts */
.post {
  border-radius: 27px;
  padding: 17px;
  margin-bottom: 20px;
}

.post-image {
  border-radius: 20px;
  border: 1px solid #ffffff30;
  box-shadow: 0 8px 25px #0004;
}

.action {
  transition: transform .2s, color .2s;
}

.action:active {
  transform: scale(1.15);
}

.action.liked {
  color: #ff76c8;
}

/* Avatar */
.avatar {
  border: 1px solid #ffffff66;
  box-shadow:
    0 4px 15px #a855f766,
    inset 0 1px 3px #ffffff66;
}

/* Floating Liquid Glass Navigation */
.nav {
  left: 12px;
  right: 12px;
  bottom: calc(9px + env(safe-area-inset-bottom));
  max-width: 620px;
  margin: auto;
  padding: 12px 8px;
  border: 1px solid rgba(255,255,255,.24);
  border-radius: 26px;
  background: rgba(35,20,57,.58);
  backdrop-filter: blur(32px) saturate(190%);
  -webkit-backdrop-filter: blur(32px) saturate(190%);
  box-shadow:
    0 12px 40px #0007,
    inset 0 1px 2px #ffffff30;
}

.nav button {
  min-width: 58px;
  padding: 5px 9px;
  border-radius: 16px;
  transition: .2s;
}

.nav button.active {
  color: white;
  background: linear-gradient(
    135deg,
    rgba(192,132,252,.35),
    rgba(236,72,153,.2)
  );
  box-shadow: inset 0 1px 2px #ffffff35;
}

.nav .symbol {
  font-size: 23px;
}

/* Profile */
.profile {
  border-radius: 28px;
}

.stats {
  gap: 45px;
}

/* Smooth transitions */
.page.active {
  animation: liquidAppear .3s ease;
}

@keyframes liquidAppear {
  from {
    opacity: 0;
    transform: translateY(8px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

/* Better mobile experience */
button,
.nav,
.post,
.glass {
  -webkit-tap-highlight-color: transparent;
}

@media (prefers-reduced-motion: reduce) {
  *, *::before, *::after {
    animation-duration: .01ms !important;
    transition-duration: .01ms !important;
  }
}
